coverage/
.test_coverage.dart
doc/api/

# --- Native artifacts ------------------------------------------------------
# BrainFlow binaries are downloaded by hook/build.dart (or provided via the
# lib_dir user-define); never commit them. Vendored headers ARE committed.
*.so
*.so.*
*.dylib
*.dll
*.a
*.lib
*.aar
compiled_libs.tar

